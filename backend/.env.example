# Local dev only. On Vercel these are set as Project Environment Variables
# (Settings -> Environment Variables) - PORT is ignored there.
PORT=8000

# URL of the FastAPI inference service that /api/infer proxies to.
# Local:      http://localhost:8001
# Production: https://<your-inference-project>.vercel.app
PYTHON_SERVICE_URL=http://localhost:8001

# Comma-separated allowlist of frontend origins permitted by CORS.
# Leave unset to allow all origins (fine for local dev).
# Production: https://<your-frontend-project>.vercel.app
CORS_ORIGIN=

# Where to send the browser after Google sign-in completes. Must be the
# frontend's origin, NOT this API's.
FRONTEND_URL=http://localhost:3000

# --- Cloudflare D1 -----------------------------------------------------------
# This backend reaches D1 over the REST API (bindings only exist inside
# Workers), so all three are required for anything beyond /api/health.
#
#   wrangler d1 create analyzehive        -> prints the database id
#   Account ID is in the Cloudflare dashboard sidebar.
#
# The API token needs exactly one permission: Account -> D1 -> Edit.
# Create it at https://dash.cloudflare.com/profile/api-tokens
# It is account-scoped - treat it like a production database password.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Optional. Point local dev at `npm run db:local` (scripts/local-d1-server.ts)
# instead of live Cloudflare D1 - a real sqlite file at the repo root's
# database/local.db, migrated automatically on first run, speaking the same
# REST envelope. The three vars above still have to be non-empty (any
# placeholder works) but their values are never read by the emulator. Leave
# unset to hit real D1.
CLOUDFLARE_D1_API_BASE=http://localhost:8788

# --- Google OAuth ------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials
#   -> Create OAuth client ID -> Web application
#
# Authorised redirect URI must match GOOGLE_REDIRECT_URI *exactly*, including
# scheme, port and path. Add one entry per environment.
#   Local:      http://localhost:8000/api/auth/google/callback
#   Production: https://<your-backend-project>.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Optional. Restricts sign-in to one Google Workspace domain before the round
# trip even starts. The users table is still the real allowlist - this is only
# defence in depth, and must be left blank for personal gmail.com accounts.
GOOGLE_HOSTED_DOMAIN=

# --- SAP Business Accelerator Hub sandbox ------------------------------------
# Optional. Powers a real network probe against sandbox.api.sap.com (not a
# company's live SAP tenant, but a real hosted S/4HANA-shaped OData service)
# for the "SAP S/4HANA (live sandbox)" row on the command-center dashboard's
# Systems of record panel. Leave unset and that panel just shows the seeded
# synthetic rows like every other system there.
#
#   1. Sign up free at https://api.sap.com
#   2. Search "Business Partner (A2X)" -> open it -> "Show API Key"
SAP_SANDBOX_API_KEY=

# --- Transactional email (Resend) --------------------------------------------
# Optional. Powers real delivery of the account-activation / password-reset
# link from POST /api/auth/password/request. Leave unset and that endpoint
# keeps its current behaviour: the link is logged server-side and echoed in
# the JSON response outside production (see backend/src/services/email.ts).
#
#   1. Sign up free at https://resend.com
#   2. Create an API key (Dashboard -> API Keys)
#   3. Without a verified sending domain, onboarding@resend.dev only delivers
#      to the email address the Resend account was created with - fine for a
#      prototype, but verify a domain (Dashboard -> Domains) to email anyone
#      else. Set EMAIL_FROM once you have one, e.g. "Nexus <noreply@yourco.com>".
RESEND_API_KEY=
EMAIL_FROM=
