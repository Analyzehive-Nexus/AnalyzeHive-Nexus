# Local dev only. On Vercel these are set as Project Environment Variables
# (Settings -> Environment Variables) - PORT is ignored there.
PORT=8000

# URL of the FastAPI inference service that /api/infer proxies to.
# Local:      http://localhost:8001
# Production: https://<your-inference-project>.vercel.app
PYTHON_SERVICE_URL=http://localhost:8001

# Comma-separated allowlist of frontend origins permitted by CORS.
# Leave unset to allow all origins (fine for local dev).
# Production: https://<your-frontend-project>.vercel.app
CORS_ORIGIN=
