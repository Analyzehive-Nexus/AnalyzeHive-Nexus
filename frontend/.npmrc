# react-simple-maps@3 declares peer react "^16.8 || 17.x || 18.x" and has not
# published a React 19 release, so a strict peer resolution fails outright on
# install. The library itself works against React 19; only the metadata is
# stale. Vercel reads this file during its install step, so without it the
# production build fails before it starts.
legacy-peer-deps=true
